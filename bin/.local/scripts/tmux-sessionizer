#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find $(cat ~/.tmux-sessionizer-locations | envsubst) -maxdepth 1 -mindepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

create_windows() {
    tmux new-session -d -s "$selected_name" -c "$selected" -n "nvim " "nvim; exec \$SHELL"
    tmux new-window -t "$selected_name" -c "$selected" -n "cmd  "
}

if [[ -z $TMUX ]]; then
    if ! tmux has-session -t=$selected_name 2> /dev/null; then
        create_windows
    fi
    tmux attach-session -t "$selected_name"
else
    if ! tmux has-session -t=$selected_name 2> /dev/null; then
        create_windows
    fi

    tmux switch-client -t "$selected_name"
fi
